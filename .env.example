# Copy to .env and fill in. Never commit the filled version.

APP_NAME=clean-arch-starter
APP_ENV=development

APP_HTTP_PORT=8080
APP_HTTP_READ_TIMEOUT=10s
APP_HTTP_WRITE_TIMEOUT=10s
# Comma-separated proxy addresses allowed to set X-Forwarded-For. MUST be set when the
# API sits behind a proxy or load balancer: otherwise every request looks like it came
# from the proxy and the per-IP auth rate limit becomes one bucket for all users.
# Leave empty when the API is exposed directly; trusting the header unconditionally
# would let any client forge an address and evade the limit.
APP_HTTP_TRUSTED_PROXIES=

# postgres | mysql | mongo
APP_DATABASE_DRIVER=postgres
APP_DATABASE_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
APP_DATABASE_MAX_OPEN_CONNS=10
APP_DATABASE_MAX_IDLE_CONNS=5
APP_DATABASE_CONN_MAX_LIFE=30m

# Only read when APP_DATABASE_DRIVER=mongo
APP_MONGO_URI=mongodb://app:app@localhost:27017
APP_MONGO_DATABASE=app

# Required. Must be >= 32 chars when APP_ENV=production.
# Generate with: openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_ISSUER=clean-arch-starter
APP_JWT_AUDIENCE=clean-arch-starter-api
APP_JWT_ACCESS_TTL=15m
# Refresh token lifetime. Rotation does NOT extend it: the successor inherits the
# original expiry, so a session has a hard ceiling and re-login is eventually required.
APP_JWT_REFRESH_TTL=168h

# OAuth2 / OpenID Connect. Every value below is required when enabled.
# The values below match the Keycloak realm in deploy/keycloak/realm-clean-arch.json,
# started with: docker compose --profile keycloak up -d keycloak
# Flip APP_OIDC_ENABLED to true once Keycloak is healthy.
APP_OIDC_ENABLED=false
# Must match Keycloak's `iss` byte-for-byte. Check it with:
#   curl -s $APP_OIDC_ISSUER_URL/.well-known/openid-configuration | jq -r .issuer
APP_OIDC_ISSUER_URL=http://localhost:8081/realms/clean-arch
APP_OIDC_CLIENT_ID=clean-arch-api
# Dev-only secret from the committed realm file. Rotate for any shared environment.
APP_OIDC_CLIENT_SECRET=clean-arch-dev-secret
APP_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
# Where the provider sends the browser after RP-initiated logout. Leave empty to land
# on Keycloak's own "logged out" page. Any value here must be registered on the client
# (post.logout.redirect.uris in deploy/keycloak/realm-clean-arch.json).
APP_OIDC_POST_LOGOUT_REDIRECT_URL=
APP_OIDC_SCOPES=openid profile email
APP_OIDC_LOGIN_STATE_TTL=5m

# Keycloak container (compose profile "keycloak"), not read by the Go app.
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

APP_LOGGING_LEVEL=info
APP_LOGGING_PRETTY=true

APP_REQUEST_LOGGER_ENABLED=true
APP_RECOVERY_ENABLED=true
APP_CORS_ENABLED=true
# Comma-separated allowlist. "*" is fine for local dev, set real origins in production.
APP_CORS_ORIGINS=*
APP_JWT_MIDDLEWARE_ENABLED=true
# Requests per minute per client IP across the four /auth endpoints. Clients behind
# one NAT share this budget, so keep it generous.
APP_AUTH_RATE_LIMIT=60
